___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const logToConsole = require('logToConsole');
const makeString = require('makeString');

const SCRIPT_URL = 'https://cdn.iintf.co/help-me-choose-client/js/app.js';

// Accept either the bare project ID or the full "hmc:<id>" key from the snippet.
let projectId = makeString(data.projectId).trim();
if (projectId.indexOf('hmc:') === 0) {
  projectId = projectId.slice(4).trim();
}

if (!projectId) {
  logToConsole('Help Me Choose AI: no project ID set, quiz not loaded.');
  data.gtmOnFailure();
  return;
}

// The widget reads this key when app.js runs, so it must be set before injecting.
setInWindow('iintf_data', { key: 'hmc:' + projectId }, true);

// The cache token stops a second firing on the same page from loading app.js again.
injectScript(SCRIPT_URL, data.gtmOnSuccess, data.gtmOnFailure, SCRIPT_URL);


