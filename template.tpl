___TESTS___

scenarios:
- name: Sets the project key before loading the widget
  code: |-
    const calls = [];
    mock('setInWindow', (key, value, overwrite) => {
      calls.push(['setInWindow', key, value, overwrite]);
      return true;
    });
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      calls.push(['injectScript', url, cacheToken]);
      onSuccess();
    });

    runCode({ projectId: 'org-1a2b3c4d' });

    assertThat(calls).isEqualTo([
      ['setInWindow', 'iintf_data', { key: 'hmc:org-1a2b3c4d' }, true],
      ['injectScript', scriptUrl, scriptUrl],
    ]);
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Accepts the full hmc key and surrounding spaces
  code: |-
    mock('injectScript', (url, onSuccess) => onSuccess());

    runCode({ projectId: '  hmc:my-store ' });

    assertApi('setInWindow').wasCalledWith('iintf_data', { key: 'hmc:my-store' }, true);
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails without loading anything when the project ID is empty
  code: |-
    runCode({ projectId: 'hmc:' });

    assertApi('setInWindow').wasNotCalled();
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
- name: Reports failure when the widget script cannot load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => onFailure());

    runCode({ projectId: 'org-1a2b3c4d' });

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
